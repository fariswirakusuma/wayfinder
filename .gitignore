*.db-shm
*.db-wal

_build/
_site/

# ==========================================
# Three.js / Deck.GL / WebGL Additions
# ==========================================
# Node / Package managers (if using npm/yarn/pnpm for Three.js/Deck.GL bundling)
node_modules/
.npm/
.yarn/
.pnpm-store/
yarn-debug.log*
yarn-error.log*
npm-debug.log*
lerna-debug.log*

# JavaScript/TypeScript build outputs & caches
# Exclude bundled JS artifacts in wwwroot if using a build pipeline (Webpack, Vite, esbuild)
# wwwroot/js/dist/
# wwwroot/js/bundle.js
# wwwroot/js/*.map
.pnpm-debug.log*
.eslintcache
.stylelintcache
.parcel-cache/
.vite/
*.tsbuildinfo

# Large 3D Models, Textures, and Asset Caches
# Un-comment or adjust paths based on where you store heavy local assets vs CDN
# wwwroot/models/*.gltf
# wwwroot/models/*.glb
# wwwroot/models/*.obj
# wwwroot/textures/large/
*.bin
*.gltf.cache

